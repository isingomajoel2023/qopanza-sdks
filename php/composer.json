{
  "name": "qopanza/sdk",
  "description": "PHP client for the Qopanza API (post-quantum cryptography + crypto discovery)",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Gsente LLC"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Qopanza\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Qopanza\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "homepage": "https://qopanza.com",
  "keywords": [
    "post-quantum",
    "cryptography",
    "pqc",
    "ml-kem",
    "ml-dsa",
    "security",
    "encryption",
    "qopanza"
  ],
  "support": {
    "issues": "https://github.com/isingomajoel2023/qopanza-sdks/issues",
    "source": "https://github.com/isingomajoel2023/qopanza-sdks"
  }
}
